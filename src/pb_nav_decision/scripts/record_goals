#!/usr/bin/python3
"""Record the latest two poses from RViz's standalone SetGoal tool."""
import math
from pathlib import Path

from geometry_msgs.msg import PoseStamped
import rclpy
from rclpy.node import Node

from pb_nav_decision.goal_store import (
    StoredGoal,
    append_latest,
    default_goal_file,
    load_goal_history,
    save_goals,
)


class GoalRecorder(Node):
    def __init__(self, **kwargs):
        super().__init__('record_decision_goals', **kwargs)
        self.declare_parameter('input_topic', 'decision/record_goal')
        self.declare_parameter('goal_file', default_goal_file())
        self.declare_parameter('reset', False)
        self.declare_parameter('frame_id', 'map')

        self._goal_file = self.get_parameter('goal_file').value
        self._frame_id = self.get_parameter('frame_id').value
        if self.get_parameter('reset').value:
            self._goals = [None, None]
            save_goals(self._goal_file, self._goals)
        elif not Path(self._goal_file).expanduser().exists():
            self._goals = [None, None]
        else:
            self._goals = list(load_goal_history(self._goal_file))
        self._subscription = self.create_subscription(
            PoseStamped,
            self.get_parameter('input_topic').value,
            self._on_goal,
            10,
        )
        self.get_logger().info(
            f"Recording poses from {self.get_parameter('input_topic').value} "
            f"to {self._goal_file}; first two fill point_one/point_two, "
            'then the oldest point is replaced.'
        )

    def _on_goal(self, msg):
        if msg.header.frame_id != self._frame_id:
            self.get_logger().warning(
                f"Ignoring goal in frame {msg.header.frame_id!r}; expected {self._frame_id!r}"
            )
            return
        q = msg.pose.orientation
        norm = math.sqrt(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w)
        if not math.isfinite(norm) or norm < 1e-9:
            self.get_logger().warning('Ignoring goal with an invalid orientation')
            return
        yaw = math.atan2(
            2.0 * (q.w * q.z + q.x * q.y),
            1.0 - 2.0 * (q.y * q.y + q.z * q.z),
        )
        goal = StoredGoal(float(msg.pose.position.x), float(msg.pose.position.y), yaw)
        if not all(math.isfinite(value) for value in (goal.x, goal.y, goal.yaw)):
            self.get_logger().warning('Ignoring goal with a non-finite coordinate')
            return
        self._goals, slot = append_latest(self._goals, goal)
        save_goals(self._goal_file, self._goals)
        self.get_logger().info(
            f"Saved {slot}: x={goal.x:.4f}, y={goal.y:.4f}, yaw={goal.yaw:.4f}"
        )


def main(args=None):
    rclpy.init(args=args)
    node = None
    try:
        node = GoalRecorder()
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        if node is not None:
            node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
